# Infraestructura pública de Supabase (nunca uses service_role en NEXT_PUBLIC_).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_PUBLIC_ANON_KEY

# SECRETA: Service Role exclusiva para Route Handlers de Node.js.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVER_ONLY_SERVICE_ROLE_KEY

# SECRETA: 32 bytes aleatorios en Base64 para AES-256-GCM.
ENCRYPTION_MASTER_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY

# URL pública de la aplicación, sin barra final.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Las credenciales de Meta, WhatsApp, Facebook, Instagram, TikTok, Twilio,
# Telnyx y proveedores de IA se configuran por empresa en la bóveda cifrada.
# No se definen variables globales de clientes ni secretos de Meta en Vercel.
