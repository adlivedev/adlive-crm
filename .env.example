# URL pública del proyecto Supabase (segura para navegador y servidor).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Clave pública de Supabase. Configura UNA de las dos; nunca uses service_role.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Alternativa compatible con proyectos que usan la anon key JWT:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_PUBLIC_ANON_KEY

# Habilita el registro público solo si el modelo comercial lo permite.
NEXT_PUBLIC_ALLOW_PUBLIC_SIGNUP=false

# URL usada en desarrollo por Auth y Meta (sin barra final).
# Producción fija https://adlive-crm.vercel.app en src/shared/lib/appOrigin.ts.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SECRETA: Service Role exclusiva para Route Handlers de webhooks en Node.js.
# No exponer como NEXT_PUBLIC_ ni importar admin.ts desde componentes cliente.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVER_ONLY_SERVICE_ROLE_KEY

# SECRETA: 32 bytes aleatorios en Base64 (AES-256-GCM).
# Generar localmente con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_MASTER_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY

# SECRETAS: verificación del webhook de Meta WhatsApp Cloud API.
META_APP_SECRET=REPLACE_WITH_META_APP_SECRET
WHATSAPP_VERIFY_TOKEN=REPLACE_WITH_RANDOM_VERIFY_TOKEN

# Orígenes de landing autorizados para lead-web, separados por comas.
# No incluir rutas ni barra final. Ejemplo: https://www.ejemplo.com,https://ejemplo.com
ALLOWED_WEBHOOK_ORIGINS=http://localhost:3000

# Modelos opcionales para los bots. Las API keys de OpenAI, Anthropic, xAI y
# Gemini se guardan por tenant desde Ajustes > Bots IA, cifradas en la bóveda.
# No uses variables NEXT_PUBLIC_ para esas claves ni para el Access Token de WhatsApp.
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-4-5
XAI_MODEL=grok-3-mini
GEMINI_MODEL=gemini-2.5-flash
